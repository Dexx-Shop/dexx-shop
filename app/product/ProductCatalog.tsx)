"use client";

import React, { useState } from "react";
import { GameCategoryCard } from "./GameCategoryCard";

interface Product {
  id: string;
  title: string;
  game?: string; // "rust" veya "fivem" (veya tag/kategori olarak tanımlanan alan)
  tags?: string[];
  price?: number | string;
  [key: string]: any;
}

export function ProductCatalog({ products = [] }: { products: any[] }) {
  // Seçilen aktif oyun (varsayılan "rust" veya null)
  const [selectedGame, setSelectedGame] = useState<string>("rust");

  // Rust Ürünleri & Fiyat Hesaplama
  const rustProducts = products.filter((p) => {
    const title = p.title?.toLowerCase() || "";
    const game = p.game?.toLowerCase() || "";
    const tags = p.tags?.map((t: string) => t.toLowerCase()) || [];
    return title.includes("rust") || game === "rust" || tags.includes("rust");
  });

  const rustPrices = rustProducts
    .map((p) => Number(p.priceRange?.minVariantPrice?.amount || p.price || 0))
    .filter((price) => price > 0);
  const rustMinPrice = rustPrices.length > 0 ? Math.min(...rustPrices) : 0;

  // FiveM Ürünleri & Fiyat Hesaplama
  const fivemProducts = products.filter((p) => {
    const title = p.title?.toLowerCase() || "";
    const game = p.game?.toLowerCase() || "";
    const tags = p.tags?.map((t: string) => t.toLowerCase()) || [];
    return (
      title.includes("fivem") ||
      title.includes("gta") ||
      game === "fivem" ||
      tags.includes("fivem")
    );
  });

  const fivemPrices = fivemProducts
    .map((p) => Number(p.priceRange?.minVariantPrice?.amount || p.price || 0))
    .filter((price) => price > 0);
  const fivemMinPrice = fivemPrices.length > 0 ? Math.min(...fivemPrices) : 0;

  // Şu an listelenecek ürünler
  const activeProducts = selectedGame === "rust" ? rustProducts : fivemProducts;

  return (
    <section id="products" className="w-full max-w-7xl mx-auto px-6 py-20 flex flex-col items-center">
      
      {/* 1. BAŞLIK */}
      <div className="flex items-center gap-2 mb-12">
        <h2 className="text-4xl sm:text-5xl font-black tracking-tight text-white">
          Mevcut <span className="text-red-500 border border-red-500/30 px-3 py-0.5 rounded-2xl bg-red-950/20">Kategoriler</span>
        </h2>
      </div>

      {/* 2. OYUN KATEGORİ KARTLARI (RUST & FIVEM) */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-3xl justify-items-center mb-16">
        
        {/* RUST KARTI */}
        <GameCategoryCard
          title="Rust Hileleri"
          gameKey="rust"
          coverImage="/rust-hero.png" // Veya beğendiğin Rust poster görseli
          productCount={rustProducts.length}
          minPrice={rustMinPrice}
          isSelected={selectedGame === "rust"}
          onSelect={(key) => setSelectedGame(key)}
        />

        {/* FIVEM KARTI */}
        <GameCategoryCard
          title="FiveM Hileleri"
          gameKey="fivem"
          coverImage="/fivem-hero.png" // Veya beğendiğin FiveM poster görseli
          productCount={fivemProducts.length}
          minPrice={fivemMinPrice}
          isSelected={selectedGame === "fivem"}
          onSelect={(key) => setSelectedGame(key)}
        />

      </div>

      {/* 3. SEÇİLEN OYUNA AİT ÜRÜNLER LİSTESİ */}
      <div className="w-full">
        <div className="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-8">
          <h3 className="text-2xl font-black text-white uppercase tracking-tight flex items-center gap-2">
            <span className="w-2.5 h-2.5 rounded-full bg-red-500" />
            {selectedGame === "rust" ? "Rust Yazılımları" : "FiveM Yazılımları"}
          </h3>
          <span className="text-sm font-semibold text-neutral-400">
            {activeProducts.length} ürün listeleniyor
          </span>
        </div>

        {/* Ürün Kartları Grid'i (Kendi CometCard bileşenini burada render edebilirsin) */}
        {activeProducts.length > 0 ? (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {activeProducts.map((product) => (
              <div key={product.id} className="w-full">
                {/* Buraya projedeki CometCard veya ProductCard bileşenin gelir */}
                <div className="p-4 rounded-2xl bg-[#0f0f12] border border-white/10 text-white">
                  <span className="text-xs uppercase font-bold text-red-500">{product.title}</span>
                  {/* ...diğer ürün bilgileri */}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div className="text-center py-12 text-neutral-500 text-sm font-medium">
            Bu kategoriye ait henüz ürün bulunmuyor.
          </div>
        )}
      </div>

    </section>
  );
}